<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>8</gap>
    <decoration>server</decoration>
  </core>
  <theme>
    <name>Clearlooks</name>
    <cornerRadius>8</cornerRadius>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-f">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="firefox-esr" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="mousepad" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="steam" />
    </keybind>
  </keyboard>
</labwc_config>
